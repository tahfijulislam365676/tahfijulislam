        "cors": "^2.8.6",
        "express": "^5.3.0",
        "framer-motion": "^14.3.0",
        "jsonwebtoken": "^9.0.3",
        "lucide-react": "^1.59.0",
        "multer": "^2.4.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-router-dom": "^7.18.4",
        "tailwindcss": "^4.3.3"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
