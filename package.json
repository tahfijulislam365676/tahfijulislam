    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "concurrently -n web,api -c cyan,magenta \"npm:dev:client\" \"npm:dev:server\"",
        "build": "vite build",
        "lint": "oxlint",
        "preview": "vite preview",
        "dev:client": "vite",
        "dev:server": "npm --prefix server run dev",
